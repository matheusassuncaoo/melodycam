    "@fontsource-variable/unbounded": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.22",
    "gsap": "^3.15.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
